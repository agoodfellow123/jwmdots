<JWM>
    <Program label="App Select" icon="/usr/share/icons/Qogir/scalable/apps/gnome-searchtool.png">/usr/local/bin/app-select</Program>
    <Program label="Terminal" icon="/usr/share/icons/Qogir/scalable/apps/terminal.png">desktop-defaults-run -t</Program>
    <Program label="File Manager" icon="/usr/share/icons/Qogir/48/apps/file-manager.png">desktop-defaults-run -fm</Program>
    <Program label="Web Browser" icon="/usr/share/icons/Qogir/scalable/apps/web-browser.png">desktop-defaults-run -b</Program>
    <Program label="Editor" icon="/usr/share/icons/Qogir/scalable/apps/leafpad.png">desktop-defaults-run -te</Program>
    <Separator/>
    <Menu label="Personal" icon="/usr/share/icons/Qogir/scalable/places/user-identity.png">
        <Include>$HOME/.jwm/personal</Include>
    </Menu>
    <Menu label="Applications" icon="/usr/share/icons/Qogir/scalable/apps/applications-all.png">
        <Include>$HOME/.jwm/menu-applications</Include>
    </Menu>
    <Program label="Refresh Menu" icon="/usr/share/icons/Qogir/scalable/apps/reload.png">desktop-menu --write-out-global &amp;&amp; jwm -restart</Program>
    <Separator/>
    <Menu label="Desktop" icon="/usr/share/icons/Qogir/48/places/user-desktop.png">
        <Menu label="Other Desktops" icon="/usr/share/icons/Qogir/48/places/user-desktop.png">
            <Include>/usr/share/desktop-session/wm-menus/jwm-wm-menu</Include>
        </Menu>
        <Program label="RoxPanel on/off" icon="/usr/share/icons/Qogir/48/places/folder_color_default.png">paneltoggle.sh</Program>
        <Program label="Conky on/off" icon="/usr/share/icons/Qogir/48/places/folder_color_default.png">conkytoggle.sh</Program>
    </Menu>
    <Separator/>
    <Program label="App Killer" icon="/usr/share/icons/Qogir/scalable/apps/offgame.png">xkill</Program>
    <Program label="Control Centre" icon="/usr/share/icons/Qogir/scalable/apps/control-center2.png">antixcc.sh</Program>
    <Program label="Run" icon="/usr/share/icons/Qogir/48/apps/applications-utilities.png">gexec</Program>
    <Separator/>
    <Include>$HOME/.jwm/themes-list</Include>
    <Program label="antiX Installer" icon="/usr/share/icons/msystem.png">sudo minstall</Program>
</JWM>
