<?xml version="1.0"?>

<JWM>

<!-- Initialize the applications used in conjunction with JWM -->
<Include>$HOME/.jwm/startup</Include>

<!-- The root menu, if this is undefined you will not get a menu. -->
<!-- Additional RootMenu attributes: onroot, labeled, label -->
<RootMenu height="30">

   <!-- The backbone antiX menu -->
   <Include>$HOME/.jwm/menu</Include>

   <Separator/>
   <Menu label="Power Menu" icon="/home/demo/.icons/NsCDE/48x48/actions/application-exit.png">
     <Restart label="Restart JWM" icon="/home/demo/.icons/NsCDE/48x48/actions/view-refresh.png"/>
     <Program label="Exit Sesion" icon="/home/demo/.icons/NsCDE/48x48/actions/edit-clear-rtl.png">desktop-session-exit</Program>
   </Menu>
</RootMenu>

<Include>$HOME/.jwm/keys</Include>
<Include>$HOME/.jwm/theme</Include>
<Include>$HOME/.jwm/tray</Include>
<Include>$HOME/.jwm/preferences</Include>

<Group>
    <Class>Alacritty</Class>
    <Option>noborder</Option>
</Group>

</JWM>
