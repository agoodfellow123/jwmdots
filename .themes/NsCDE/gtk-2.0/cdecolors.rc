style "cde_style_1"
{
    fg[NORMAL]  ="#000000"
    bg[NORMAL]  ="#afbffb"
    text[NORMAL]="#000000"
    base[NORMAL]="#afbffb"

    fg[ACTIVE]  ="#000000"
    bg[ACTIVE]  ="#95a2d6"
    text[ACTIVE]="#000000"
    base[ACTIVE]="#95a2d6"

    fg[PRELIGHT]="#000000"
    bg[PRELIGHT]="#afbffb"
    text[PRELIGHT]="#000000"
    base[PRELIGHT] ="#afbffb"

    fg[SELECTED]="#afbffb"
    bg[SELECTED]="#000000"
    text[SELECTED]="#afbffb"
    base[SELECTED]="#000000"

    # This is the dark color of the etched in insensitive text when on normal background of widget
    fg[INSENSITIVE]="#626b8c"
    bg[INSENSITIVE]="#afbffb"
    # Insensitive text color in entry and also fg color of etched in text in combo box
    text[INSENSITIVE]="#626b8c"
    # In cde this is normal bg color
    base[INSENSITIVE]="#afbffb"
}

